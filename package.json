{
  "name": "cleye",
  "version": "0.0.0-semantic-release",
  "description": "The intuitive CLI development tool",
  "keywords": [
    "cli",
    "command line",
    "argv",
    "parameters",
    "flags",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "repository": "privatenumber/cleye",
  "funding": "https://github.com/privatenumber/cleye?sponsor=1",
  "author": {
    "name": "Hiroki Osame",
    "email": "hiroki.osame@gmail.com"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./formats": {
      "types": "./dist/formats.d.mts",
      "default": "./dist/formats.mjs"
    },
    "./help": {
      "types": "./dist/help.d.mts",
      "default": "./dist/help.mjs"
    },
    "./help/responsive": {
      "types": "./dist/help/responsive.d.mts",
      "default": "./dist/help/responsive.mjs"
    }
  },
  "imports": {
    "#cleye": {
      "default": "./dist/index.mjs"
    },
    "#cleye/formats": {
      "default": "./dist/formats.mjs"
    },
    "#cleye/help": {
      "default": "./dist/help.mjs"
    },
    "#cleye/help/responsive": {
      "default": "./dist/help/responsive.mjs"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "ansis": "4.3.0",
    "string-width": "8.2.1",
    "type-flag": "5.0.0-beta.10"
  }
}