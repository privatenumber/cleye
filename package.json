{
	"name": "cleye",
	"version": "0.0.0-semantic-release",
	"description": "The intuitive CLI development tool",
	"keywords": [
		"cli",
		"command line",
		"argv",
		"parameters",
		"flags",
		"node",
		"typescript"
	],
	"license": "MIT",
	"repository": "privatenumber/cleye",
	"funding": "https://github.com/privatenumber/cleye?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./formats": {
			"types": "./dist/formats.d.mts",
			"default": "./dist/formats.mjs"
		},
		"./help": {
			"types": "./dist/help.d.mts",
			"default": "./dist/help.mjs"
		},
		"./renderers/responsive": {
			"types": "./dist/renderers/responsive.d.mts",
			"default": "./dist/renderers/responsive.mjs"
		}
	},
	"imports": {
		"#cleye": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"#cleye/formats": {
			"types": "./src/formats.ts",
			"development": "./src/formats.ts",
			"default": "./dist/formats.mjs"
		},
		"#cleye/help": {
			"types": "./src/help.ts",
			"development": "./src/help.ts",
			"default": "./dist/help.mjs"
		},
		"#cleye/renderers/responsive": {
			"types": "./src/renderers/responsive.ts",
			"development": "./src/renderers/responsive.ts",
			"default": "./dist/renderers/responsive.mjs"
		}
	},
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"build": "pkgroll --minify",
		"lint": "lintroll --cache --git",
		"type-check": "tsc",
		"test": "FORCE_COLOR=1 node tests/index.ts",
		"dev": "FORCE_COLOR=1 node --watch --conditions=development tests/index.ts",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"ansis": "4.2.0",
		"string-width": "^8.2.0",
		"terminal-columns": "^2.0.0",
		"type-flag": "5.0.0-beta.6"
	},
	"devDependencies": {
		"@types/node": "^24.9.2",
		"clean-pkg-json": "^1.3.0",
		"expect-type": "^1.2.2",
		"fastest-levenshtein": "^1.0.16",
		"kolorist": "^1.8.0",
		"lintroll": "^1.24.2",
		"manten": "^2.0.0",
		"nanospy": "^1.0.0",
		"pkgroll": "^2.20.1",
		"skills-npm": "^1.0.0",
		"typescript": "^5.9.3"
	}
}
